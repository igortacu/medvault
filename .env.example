POSTGRES_SUPERUSER_PASSWORD=changeme_superuser
MIGRATOR_PASSWORD=changeme_migrator
APP_USER_PASSWORD=changeme_app_user

# Alembic migrations connect as the migrator role with the SYNC psycopg2 driver.
DATABASE_URL=postgresql+psycopg2://migrator:changeme_migrator@localhost:5432/medvault

# The FastAPI app connects as the app_user role (RLS-constrained) with the ASYNC
# asyncpg driver. Kept separate so migrations and the app don't share a driver/role.
DATABASE_URL_ASYNC=postgresql+asyncpg://app_user:changeme_app_user@localhost:5432/medvault

# Object storage for original document files (used by GET /documents/{id}/original).
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=changeme_minio_access
MINIO_SECRET_KEY=changeme_minio_secret
MINIO_SECURE=false

REDIS_URL=redis://localhost:6379/0
INSTITUTION_MOCK_BASE_URL=http://localhost:8001
INSTITUTION_MOCK_REDIRECT_URI=http://localhost:8000/api/v1/institutions/callback
INSTITUTION_CALLBACK_URL=http://localhost:8000/api/v1/institutions/callback
FRONTEND_URL=http://localhost:5173
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace_with_a_fernet_key
